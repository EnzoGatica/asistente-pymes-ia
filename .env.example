# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio.

# Secreto: llave de la API de OpenAI (https://platform.openai.com/api-keys).
# Vacía, el servicio arranca igual, /salud informa "sin clave" y POST /consultas responde 503.
OPENAI_API_KEY=

# Configuración: desarrollo o produccion.
ENTORNO=desarrollo
